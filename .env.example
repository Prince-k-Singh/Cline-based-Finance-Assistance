# Copy this file to .env and add a key. Needed only for the AI features
# (Ask Parivar, statement categoriser, check-in notes, market analyst).
# All calculations, live market analytics and spending alerts work without a key.
# Cline API (recommended): key from https://app.cline.bot
CLINE_PROVIDER=cline
CLINE_MODEL=anthropic/claude-sonnet-4.6
CLINE_API_KEY=
# Alternatives: CLINE_PROVIDER=anthropic + ANTHROPIC_API_KEY, openai + OPENAI_API_KEY, gemini + GEMINI_API_KEY
ANTHROPIC_API_KEY=
PORT=8787
